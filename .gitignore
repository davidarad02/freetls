# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
dist_sdist/
.pytest_cache/
.coverage
htmlcov/

# Native build artifacts (produced by `make native`, `pip install`, or the
# loader's auto-build). Never commit these.
native/libfreetls.so
native/libfreetls.dylib
native/libfreetls.h
native/freetls.dll
native/freetls.h
# Go-only alternate engine (produced by `make native-go`).
native/libfreetls_go.so
native/libfreetls_go.dylib
native/libfreetls_go.h
# Wide dynamic engine (produced by `make native-dynamic`).
native/libfreetls_libcrypto.so
native/libfreetls_libcrypto.dylib
native/libfreetls_libcrypto.h
src/freetls/_lib/*.so
src/freetls/_lib/*.dylib
src/freetls/_lib/*.dll
src/freetls/_lib/*.h

# Go
*.test
*.prof
coverage.out

