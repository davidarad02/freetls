diff --git a/internal/handshake/cipher_suite.go b/internal/handshake/cipher_suite.go
index f062bc7..2666084 100644
--- a/internal/handshake/cipher_suite.go
+++ b/internal/handshake/cipher_suite.go
@@ -33,6 +33,10 @@ func getCipherSuite(id uint16) cipherSuite {
 	case tls.TLS_AES_256_GCM_SHA384:
 		return cipherSuite{ID: tls.TLS_AES_256_GCM_SHA384, Hash: crypto.SHA384, KeyLen: 32, AEAD: aeadAESGCMTLS13}
 	default:
+		// [freetls] TLS 1.3 CCM suites, supplied by the libcrypto backend.
+		if cs, ok := freetlsExtraCipherSuite(id); ok {
+			return cs
+		}
 		panic(fmt.Sprintf("unknown cypher suite: %d", id))
 	}
 }
diff --git a/internal/handshake/header_protector.go b/internal/handshake/header_protector.go
index b815658..be811e8 100644
--- a/internal/handshake/header_protector.go
+++ b/internal/handshake/header_protector.go
@@ -33,6 +33,10 @@ func newHeaderProtector(suite cipherSuite, trafficSecret []byte, isLongHeader bo
 	case tls.TLS_CHACHA20_POLY1305_SHA256:
 		return newChaChaHeaderProtector(suite, trafficSecret, isLongHeader, hkdfLabel)
 	default:
+		// [freetls] CCM suites use AES-ECB header protection, like GCM.
+		if hp, ok := freetlsExtraHeaderProtector(suite, trafficSecret, isLongHeader, hkdfLabel); ok {
+			return hp
+		}
 		panic(fmt.Sprintf("Invalid cipher suite id: %d", suite.ID))
 	}
 }
